# rose-pine-moon colorscheme for micro
# Based on https://rosepinetheme.com/palette/moon
# Background colors omitted so WezTerm transparency shows through

color-link default "#e0def4"
color-link keyword "#c4a7e7"
color-link keyword.constant "#eb6f92"
color-link keyword.operator "#908caa"
color-link identifier "#c4a7e7"
color-link identifier.class "#9ccfd8"
color-link identifier.function "#9ccfd8"
color-link identifier.variable "#e0def4"
color-link type "#9ccfd8"
color-link type.keyword "#c4a7e7"
color-link constant "#eb6f92"
color-link constant.number "#eb6f92"
color-link constant.string "#f6c177"
color-link constant.string.char "#f6c177"
color-link constant.bool "#c4a7e7"
color-link constant.specialChar "#3e8fb0"
color-link statement "#c4a7e7"
color-link symbol "#e0def4"
color-link symbol.operator "#908caa"
color-link symbol.brackets "#908caa"
color-link preproc "#c4a7e7"
color-link special "#3e8fb0"
color-link underlined "#9ccfd8"
color-link comment "#6e6a86"
color-link comment.link "#9ccfd8"
color-link todo "#f6c177"
color-link error "#eb6f92"
color-link warning "#f6c177"
color-link diffadded "#31748f"
color-link diffdeleted "#eb6f92"
color-link linenumber "#6e6a86"
color-link cursorline "#2a273f"
color-link statusline "#393552,#e0def4"
color-link statusline.inactive "#2a273f,#6e6a86"
color-link tabbar "#2a273f,#e0def4"
color-link divider "#393552"
color-link cursor "#908caa"
color-link selection "#00af00,#232136"
color-link color-column "#2a273f"
color-link matchbrace "#393552,#e0def4"
color-link indent-char "#393552"
color-link trailingws "#eb6f92"
